<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NegativeEncoder.Desktop.App"
             Name="NegativeEncoder" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://NegativeEncoder.Desktop/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
