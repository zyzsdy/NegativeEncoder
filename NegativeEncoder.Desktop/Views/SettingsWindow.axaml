<views:OwnedDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NegativeEncoder.Desktop.Views" x:Class="NegativeEncoder.Desktop.Views.SettingsWindow"
        Title="设置" Width="520" Height="550" MinWidth="430" MinHeight="440">
  <Grid Margin="18" RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <Label Content="语言" Target="{Binding #LanguageField}"/>
            <ComboBox Name="LanguageField" AutomationProperties.Name="语言">
              <ComboBoxItem Content="跟随系统" Tag="system"/>
              <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
              <ComboBoxItem Content="English" Tag="en-US"/>
              <ComboBoxItem Content="日本語" Tag="ja-JP"/>
            </ComboBox>
            <TextBlock Text="当前版本的界面语言为简体中文。" Classes="muted"/>
            <Label Content="允许同时编码的进程数量" Target="{Binding #ConcurrencyField}" Margin="0,6,0,0"/>
            <TextBox Name="ConcurrencyField" AutomationProperties.Name="允许同时编码的进程数量"/>
            <StackPanel Name="WindowsShellPanel" IsVisible="{OnPlatform Windows=True, Default=False}" Spacing="6" Margin="0,6,0,0">
              <Label Content="启动工具包命令行的默认Shell" Target="{Binding #ShellField}"/>
              <ComboBox Name="ShellField" AutomationProperties.Name="启动工具包命令行的默认Shell">
                <ComboBoxItem Name="PwshOption" Tag="pwsh"/>
                <ComboBoxItem Name="CmdOption" Tag="cmd"/>
                <ComboBoxItem Content="powershell" Tag="powershell"/>
              </ComboBox>
            </StackPanel>
            <Label Content="代理服务器" Target="{Binding #ProxyAddressField}" Margin="0,6,0,0"/>
            <TextBox Name="ProxyAddressField" Watermark="http://127.0.0.1:7890 或 socks5://127.0.0.1:1080" AutomationProperties.Name="代理服务器"/>
            <TextBlock Text="用于检查更新和下载工具库。留空使用系统网络设置。" Classes="muted"/>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Name="SaveStatus" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/>
              <Button Grid.Column="1" Name="SaveButton" Content="保存设置" Classes="primary" Click="Save_Click"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Name="CheckButton" Content="立即检查更新" IsEnabled="{Binding CanCheck}" Click="Check_Click"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="关闭" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
  </Grid>
</views:OwnedDialog>
