<views:OwnedDialog xmlns="https://github.com/avaloniaui" xmlns:loc="using:NegativeEncoder.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NegativeEncoder.Desktop.Views" x:Class="NegativeEncoder.Desktop.Views.SettingsWindow"
        Title="{loc:Tr MainWindow.Settings}" Width="520" Height="550" MinWidth="430" MinHeight="440">
  <Grid Margin="18" RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <Label Content="{loc:Tr SettingsWindow.Language}" Target="{Binding #LanguageField}"/>
            <ComboBox Name="LanguageField" AutomationProperties.Name="{loc:Tr SettingsWindow.Language}">
              <ComboBoxItem Content="{loc:Tr SettingsWindow.SystemLanguage}" Tag="system"/>
              <ComboBoxItem Content="{loc:Tr SettingsWindow.Chinese}" Tag="zh-CN"/>
              <ComboBoxItem Content="{loc:Tr SettingsWindow.English}" Tag="en-US"/>
              <ComboBoxItem Content="{loc:Tr SettingsWindow.Japanese}" Tag="ja-JP"/>
            </ComboBox>
            <TextBlock Text="{loc:Tr SettingsWindow.LanguageRestart}" Classes="muted"/>
            <Label Content="{loc:Tr SettingsWindow.Concurrency}" Target="{Binding #ConcurrencyField}" Margin="0,6,0,0"/>
            <TextBox Name="ConcurrencyField" AutomationProperties.Name="{loc:Tr SettingsWindow.Concurrency}"/>
            <StackPanel Name="WindowsShellPanel" IsVisible="{OnPlatform Windows=True, Default=False}" Spacing="6" Margin="0,6,0,0">
              <Label Content="{loc:Tr SettingsWindow.ToolkitShell}" Target="{Binding #ShellField}"/>
              <ComboBox Name="ShellField" AutomationProperties.Name="{loc:Tr SettingsWindow.ToolkitShell}">
                <ComboBoxItem Name="PwshOption" Tag="pwsh"/>
                <ComboBoxItem Name="CmdOption" Tag="cmd"/>
                <ComboBoxItem Content="{loc:Tr SettingsWindow.Powershell}" Tag="powershell"/>
              </ComboBox>
            </StackPanel>
            <Label Content="{loc:Tr SettingsWindow.Proxy}" Target="{Binding #ProxyAddressField}" Margin="0,6,0,0"/>
            <TextBox Name="ProxyAddressField" Watermark="{loc:Tr SettingsWindow.ProxyExample}" AutomationProperties.Name="{loc:Tr SettingsWindow.Proxy}"/>
            <TextBlock Text="{loc:Tr SettingsWindow.ProxyHelp}" Classes="muted"/>
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Name="CheckButton" Content="{loc:Tr MainWindow.CheckUpdates}" IsEnabled="{Binding CanCheck}" Click="Check_Click"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
      <TextBlock Name="SaveStatus" AutomationProperties.LiveSetting="Polite" IsVisible="False"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="CancelButton" Content="{loc:Tr PreviewDialog.Cancel}" Click="Cancel_Click"/>
        <Button Name="SaveButton" Content="{loc:Tr SettingsWindow.SaveAndClose}" Classes="primary" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</views:OwnedDialog>
