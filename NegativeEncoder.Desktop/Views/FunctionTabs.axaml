<?xml version="1.0" ?>
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:NegativeEncoder.Desktop.Views" xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" x:Class="NegativeEncoder.Desktop.Views.FunctionTabs">


  <UserControl.Resources>
    <views:EnumEqualityConverter x:Key="EnumEquals"/>
  </UserControl.Resources>


  <TabControl Name="Tabs">
    <TabItem Header="编码器">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,12,10,12">
            <views:ResponsiveFormPanel Name="EncoderIdentityFields">
              <Grid ColumnDefinitions="120,*" Margin="0,3">
                <Label Content="编码器" Target="{Binding #EncoderSelect}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <ComboBox Name="EncoderSelect" ItemsSource="{Binding Options.EncoderOptions}" SelectedValue="{Binding CurrentPreset.Encoder}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="编码器">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
              <Grid ColumnDefinitions="120,*" Margin="0,3">
                <Label Content="输出编码" Target="{Binding #CodecSelect}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <ComboBox Name="CodecSelect" ItemsSource="{Binding Options.CodecOptions}" SelectedValue="{Binding CurrentPreset.Codec}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="输出编码">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
            </views:ResponsiveFormPanel>
            <CheckBox Content="使用自定义参数" IsChecked="{Binding CurrentPreset.IsUseCustomParameters}"/>
            <StackPanel IsVisible="{Binding CurrentPreset.IsUseCustomParameters}" Spacing="6">
              <TextBlock Text="自定义参数"/>
              <TextBox Name="CustomParametersField" Text="{Binding CurrentPreset.CustomParameters}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" Classes="code" AutomationProperties.Name="自定义参数"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding !CurrentPreset.IsUseCustomParameters}" Spacing="6">
              <TextBlock Classes="section" Text="编码模式"/>
              <views:ResponsiveFormPanel Name="RateControlFields">
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <RadioButton Content="VBR" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=VBR}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.VbrParam}" AutomationProperties.Name="VBR 参数"/>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <RadioButton Content="CBR" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=CBR}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.CbrParam}" AutomationProperties.Name="CBR 参数"/>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <RadioButton Content="CQP" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=CQP}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.CqpParam}" AutomationProperties.Name="CQP 参数"/>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,2" IsEnabled="{Binding CurrentPreset.IsQsv}">
                  <RadioButton Content="LA" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=LA}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.LaParam}" AutomationProperties.Name="LA 参数"/>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,2" IsEnabled="{Binding CurrentPreset.IsQsv}">
                  <RadioButton Content="LA-ICQ" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=LAICQ}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.LaicqParam}" AutomationProperties.Name="LAICQ 参数"/>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,2" IsEnabled="{Binding CurrentPreset.IsQsv}">
                  <RadioButton Content="QVBR" GroupName="EncodeMode" IsChecked="{Binding CurrentPreset.EncodeMode, Converter={StaticResource EnumEquals}, ConverterParameter=QVBR}"/>
                  <TextBox Grid.Column="1" Text="{Binding CurrentPreset.QvbrParam}" AutomationProperties.Name="QVBR 参数"/>
                </Grid>
              </views:ResponsiveFormPanel>
              <TextBlock Classes="section" Text="编码选项"/>
              <views:ResponsiveFormPanel Name="EncodingOptionFields">
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="质量预设" Target="{Binding #QualityPresetSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="QualityPresetSelect" ItemsSource="{Binding Options.QualityPresetOptions}" SelectedValue="{Binding CurrentPreset.QualityPreset}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="质量预设">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="色深" Target="{Binding #ColorDepthSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="ColorDepthSelect" ItemsSource="{Binding Options.ColorDepthOptions}" SelectedValue="{Binding CurrentPreset.ColorDepth}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="色深" IsEnabled="{Binding CurrentPreset.SupportsDepth}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="VBR 质量（0–51）" Target="{Binding #VbrQuailtyField}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="VbrQuailtyField" Text="{Binding CurrentPreset.VbrQuailty}" AutomationProperties.Name="VBR 质量（0–51）" IsEnabled="{Binding CurrentPreset.SupportsDepth}"/>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <CheckBox Content="最大 GOP" IsChecked="{Binding CurrentPreset.IsSetMaxGop}"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="MaxGopField" Text="{Binding CurrentPreset.MaxGop}" AutomationProperties.Name="最大 GOP" IsEnabled="{Binding CurrentPreset.IsSetMaxGop}"/>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <CheckBox Content="显示比例 DAR" IsChecked="{Binding CurrentPreset.IsSetDar}"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="DarField" Text="{Binding CurrentPreset.Dar}" AutomationProperties.Name="显示比例 DAR" IsEnabled="{Binding CurrentPreset.IsSetDar}"/>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <CheckBox Content="最大码率" IsChecked="{Binding CurrentPreset.IsSetMaxBitrate}"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="MaxBitrateField" Text="{Binding CurrentPreset.MaxBitrate}" AutomationProperties.Name="最大码率" IsEnabled="{Binding CurrentPreset.IsSetMaxBitrate}"/>
                  </Panel>
                </Grid>
                <CheckBox Content="固定 GOP" IsChecked="{Binding CurrentPreset.IsStrictGop}" IsEnabled="{Binding CurrentPreset.IsSetMaxGop}"/>
              </views:ResponsiveFormPanel>
              <TextBlock Classes="section" Text="高级选项"/>
              <views:ResponsiveFormPanel Name="AdvancedFields">
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="解码模式" Target="{Binding #DecoderSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="DecoderSelect" ItemsSource="{Binding Options.DecoderOptions}" SelectedValue="{Binding CurrentPreset.Decoder}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="解码模式">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="D3D（仅 QSV）" Target="{Binding #D3DModeSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="D3DModeSelect" ItemsSource="{Binding Options.D3DModeOptions}" SelectedValue="{Binding CurrentPreset.D3DMode}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="D3D（仅 QSV）" IsEnabled="{Binding CurrentPreset.IsQsv}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <CheckBox Content="音画同步" IsChecked="{Binding CurrentPreset.IsSetAvSync}"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="AVSyncSelect" ItemsSource="{Binding Options.AVSyncOptions}" SelectedValue="{Binding CurrentPreset.AVSync}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="同步方式" IsEnabled="{Binding CurrentPreset.IsSetAvSync}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
              </views:ResponsiveFormPanel>
              <TextBlock Classes="section" Text="画面处理"/>
              <views:ResponsiveFormPanel Name="PictureFields">
                <CheckBox Content="反交错" IsChecked="{Binding CurrentPreset.IsUseDeInterlace}"/>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="场顺序" Target="{Binding #FieldOrderSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="FieldOrderSelect" ItemsSource="{Binding Options.FieldOrderOptions}" SelectedValue="{Binding CurrentPreset.FieldOrder}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="场顺序" IsEnabled="{Binding CurrentPreset.IsUseDeInterlace}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="反交错方式" Target="{Binding #DeInterlaceMethodPresetSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="DeInterlaceMethodPresetSelect" ItemsSource="{Binding Options.DeInterlaceMethodPresetOptions}" SelectedValue="{Binding CurrentPreset.DeInterlaceMethodPreset}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="反交错方式" IsEnabled="{Binding CurrentPreset.IsUseDeInterlace}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <CheckBox Content="调整分辨率" IsChecked="{Binding CurrentPreset.IsSetOutputRes}"/>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="宽度（px）" Target="{Binding #OutputResWidthField}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="OutputResWidthField" Text="{Binding CurrentPreset.OutputResWidth}" AutomationProperties.Name="宽度（px）" IsEnabled="{Binding CurrentPreset.IsSetOutputRes}"/>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="高度（px）" Target="{Binding #OUtputResHeightField}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="OUtputResHeightField" Text="{Binding CurrentPreset.OUtputResHeight}" AutomationProperties.Name="高度（px）" IsEnabled="{Binding CurrentPreset.IsSetOutputRes}"/>
                  </Panel>
                </Grid>
              </views:ResponsiveFormPanel>
              <TextBlock Classes="section" Text="音频"/>
              <views:ResponsiveFormPanel Name="AudioFields">
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="音频处理" Target="{Binding #AudioEncodeSelect}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <ComboBox Name="AudioEncodeSelect" ItemsSource="{Binding Options.AudioEncodeOptions}" SelectedValue="{Binding CurrentPreset.AudioEncode}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="音频处理">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="120,*" Margin="0,3">
                  <Label Content="音频码率（kbps）" Target="{Binding #AudioBitrateField}" VerticalAlignment="Center"/>
                  <Panel Grid.Column="1">
                    <TextBox Name="AudioBitrateField" Text="{Binding CurrentPreset.AudioBitrate}" AutomationProperties.Name="音频码率（kbps）" IsEnabled="{Binding CurrentPreset.IsAudioEncoding}"/>
                  </Panel>
                </Grid>
              </views:ResponsiveFormPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="80,*,Auto" Margin="0,10,0,0">
          <Label Content="输出格式" Target="{Binding #OutputFormatSelect}" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Name="OutputFormatSelect" ItemsSource="{Binding Options.OutputFormatOptions}" SelectedValue="{Binding CurrentPreset.OutputFormat}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="输出格式">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Classes="primary" Content="添加到编码队列" Tag="视频编码" Click="AddTask_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem Header="HDR">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,12,10,12">
            <TextBlock Classes="section" Text="HDR 输出"/>
            <CheckBox Content="输出带有 HDR 标记的视频" IsChecked="{Binding CurrentPreset.IsOutputHdr}"/>
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="输出 HDR 格式" Target="{Binding #OutputHdrTypeSelect}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <ComboBox Name="OutputHdrTypeSelect" ItemsSource="{Binding Options.HdrTypeOptions}" SelectedValue="{Binding CurrentPreset.OutputHdrType}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="输出 HDR 格式" IsEnabled="{Binding CurrentPreset.IsOutputHdr}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Panel>
            </Grid>
            <CheckBox Content="每个 IDR 帧重复输出 Header" IsChecked="{Binding CurrentPreset.IsRepeatHeaders}" IsEnabled="{Binding CurrentPreset.IsNvenc}"/>
            <TextBlock Classes="section" Text="HDR 格式转换（仅 NVENC）"/>
            <CheckBox Content="启用 HDR 格式转换" IsChecked="{Binding CurrentPreset.IsConvertHdrType}" IsEnabled="{Binding CurrentPreset.IsNvenc}"/>
            <StackPanel IsEnabled="{Binding CurrentPreset.IsNvenc}">
              <Grid ColumnDefinitions="140,*" Margin="0,3">
                <Label Content="源格式" Target="{Binding #OldHdrTypeSelect}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <ComboBox Name="OldHdrTypeSelect" ItemsSource="{Binding Options.HdrTypeOptions}" SelectedValue="{Binding CurrentPreset.OldHdrType}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="源格式" IsEnabled="{Binding CurrentPreset.IsConvertHdrType}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
              <Grid ColumnDefinitions="140,*" Margin="0,3">
                <Label Content="目标格式" Target="{Binding #NewHdrTypeSelect}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <ComboBox Name="NewHdrTypeSelect" ItemsSource="{Binding Options.HdrTypeOptions}" SelectedValue="{Binding CurrentPreset.NewHdrType}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="目标格式" IsEnabled="{Binding CurrentPreset.IsConvertHdrType}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
              <Grid ColumnDefinitions="140,*" Margin="0,3">
                <Label Content="HDR 转 SDR 算法" Target="{Binding #Hdr2SdrMethodSelect}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <ComboBox Name="Hdr2SdrMethodSelect" ItemsSource="{Binding Options.Hdr2SdrOptions}" SelectedValue="{Binding CurrentPreset.Hdr2SdrMethod}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="HDR 转 SDR 算法" IsEnabled="{Binding CurrentPreset.IsSdrConversion}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
              <Grid ColumnDefinitions="140,*" Margin="0,3">
                <Label Content="去饱和强度（0–1）" Target="{Binding #Hdr2SdrDeSatStrengthField}" VerticalAlignment="Center"/>
                <Panel Grid.Column="1">
                  <TextBox Name="Hdr2SdrDeSatStrengthField" Text="{Binding CurrentPreset.Hdr2SdrDeSatStrength}" AutomationProperties.Name="去饱和强度（0–1）" IsEnabled="{Binding CurrentPreset.IsSdrConversion}"/>
                </Panel>
              </Grid>
            </StackPanel>
            <TextBlock Classes="section" Text="覆盖 HDR 标记（ffmpeg）"/>
            <TextBlock Classes="muted" Text="仅修改色彩元数据，不重新编码。当前只创建任务草稿。"/>
            <WrapPanel>
              <Button Content="标记为 SDR" Tag="标记为 SDR" Click="AddTask_Click" Margin="0,0,8,8"/>
              <Button Content="标记为 HDR10" Tag="标记为 HDR10" Click="AddTask_Click" Margin="0,0,8,8"/>
              <Button Content="标记为 HLG" Tag="标记为 HLG" Click="AddTask_Click" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
          <Button Classes="primary" Content="添加到编码队列（HDR）" Tag="HDR 编码" Click="AddTask_Click" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="VS">
      <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
          <Grid ColumnDefinitions="48,*,Auto" Margin="0,0,0,6">
            <Label Content="字幕" Target="{Binding #SubtitleField}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="SubtitleField" Text="{Binding Subtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="字幕"/>
            <Button Grid.Column="2" Content="浏览…" Tag="subtitle" Click="Browse_Click" Margin="8,0,0,0"/>
          </Grid>
          <Grid Grid.Row="1" Name="VsGeneratorToolbar" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <Menu Name="VsGeneratorMenu" VerticalAlignment="Center">
              <MenuItem Header="VS代码生成器">
                <MenuItem Name="GenerateVsScriptItem" Header="生成" Click="GenerateVsScript_Click"/>
                <Separator/>
                <MenuItem Header="字幕渲染器">
                  <MenuItem Header="Subtext / libass" ToggleType="Radio" GroupName="SubtitleRenderer" IsChecked="{Binding UseSubtext, Mode=TwoWay}" IsEnabled="{Binding CanSubtext}"/>
                  <MenuItem Header="xy-VSFilter" ToggleType="Radio" GroupName="SubtitleRenderer" IsChecked="{Binding UseXyVsf, Mode=TwoWay}" IsEnabled="{Binding CanXyVsf}"/>
                  <MenuItem Header="VSFilter（旧版）" ToggleType="Radio" GroupName="SubtitleRenderer" IsChecked="{Binding UseLegacyVsf, Mode=TwoWay}" IsEnabled="{Binding CanLegacyVsf}"/>
                  <MenuItem Name="UseVsfmodItem" Header="VSFilterMod" ToggleType="Radio" GroupName="SubtitleRenderer" IsChecked="{Binding UseVsfmod, Mode=TwoWay}" IsEnabled="{Binding CanVsfmod}"/>
                </MenuItem>
                <MenuItem Name="UseRepeatItem" Header="Repeat" ToggleType="CheckBox" IsChecked="{Binding UseRepeat, Mode=TwoWay}" IsEnabled="{Binding CanVsSource}"/>
                <MenuItem Name="UseQtgmcItem" Header="QTGMC" ToggleType="CheckBox" IsChecked="{Binding UseQtgmc, Mode=TwoWay}" IsEnabled="{Binding CanQtgmc}"/>
                <MenuItem Name="UseIvtcItem" Header="IVTC" ToggleType="CheckBox" IsChecked="{Binding UseIvtc, Mode=TwoWay}" IsEnabled="{Binding CanIvtc}"/>
                <MenuItem Name="UseYadifDoubleItem" Header="Yadif Double" ToggleType="CheckBox" IsChecked="{Binding UseYadifDouble, Mode=TwoWay}" IsEnabled="{Binding CanYadif}"/>
                <MenuItem Name="UseYadifNormalItem" Header="Yadif Normal" ToggleType="CheckBox" IsChecked="{Binding UseYadifNormal, Mode=TwoWay}" IsEnabled="{Binding CanYadif}"/>
                <MenuItem Name="UseBwdifNormalItem" Header="Bwdif 普通帧率" ToggleType="CheckBox" IsChecked="{Binding UseBwdifNormal, Mode=TwoWay}" IsEnabled="{Binding CanBwdif}"/>
                <MenuItem Name="UseBwdifDoubleItem" Header="Bwdif 双倍帧率" ToggleType="CheckBox" IsChecked="{Binding UseBwdifDouble, Mode=TwoWay}" IsEnabled="{Binding CanBwdif}"/>
                <Separator/>
                <MenuItem Header="工具库管理…" Click="ToolLibrary_Click"/>
              </MenuItem>
            </Menu>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <CheckBox Name="VsResizeCheckBox" Content="调整大小" IsChecked="{Binding VsResize, Mode=TwoWay}" VerticalAlignment="Center"/>
              <TextBox Name="VsWidthField" Width="60" Text="{Binding VsWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="宽度（px）" ToolTip.Tip="宽度（px）" IsEnabled="{Binding VsResize}"/>
              <TextBlock Text="×" VerticalAlignment="Center"/>
              <TextBox Name="VsHeightField" Width="60" Text="{Binding VsHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="高度（px）" ToolTip.Tip="高度（px）" IsEnabled="{Binding VsResize}"/>
            </StackPanel>
          </Grid>
          <edit:TextEditor Grid.Row="2" Name="ScriptEditor" Document="{Binding ScriptDocument}" ShowLineNumbers="True" FontFamily="{StaticResource CodeFont}" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="VapourSynth 脚本编辑器" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
          <TextBlock Text="{Binding VsIssue}" Classes="muted" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VsIssue}"/>
          <Button Classes="primary" Content="添加 VS 任务草稿" Tag="VapourSynth" Click="AddTask_Click" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="音频">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,12,10,12">
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="音频输出" Target="{Binding #AudioOutputField}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Name="AudioOutputField" Text="{Binding AudioOutput}" AutomationProperties.Name="音频输出"/>
                  <Button Grid.Column="1" Content="浏览…" Tag="audio-output" Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>
              </Panel>
            </Grid>
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="音频码率（kbps）" Target="{Binding #AudioBitrateAudioField}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <TextBox Name="AudioBitrateAudioField" Text="{Binding CurrentPreset.AudioBitrate}" AutomationProperties.Name="音频码率（kbps）"/>
              </Panel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="primary" Content="编码音频" Tag="编码音频" Click="AddTask_Click" HorizontalAlignment="Right"/>
            <Border Width="8"/>
            <Button Classes="primary" Content="提取音频" Tag="提取音频" Click="AddTask_Click" HorizontalAlignment="Right"/>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="封装">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,12,10,12">
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="音频输入" Target="{Binding #MuxAudioField}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Name="MuxAudioField" Text="{Binding MuxAudio}" AutomationProperties.Name="音频输入"/>
                  <Button Grid.Column="1" Content="浏览…" Tag="mux-audio" Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>
              </Panel>
            </Grid>
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="封装输出" Target="{Binding #MuxOutputField}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Name="MuxOutputField" Text="{Binding MuxOutput}" AutomationProperties.Name="封装输出"/>
                  <Button Grid.Column="1" Content="浏览…" Tag="mux-output" Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>
              </Panel>
            </Grid>
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="封装格式" Target="{Binding #MuxFormatSelect}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <ComboBox Name="MuxFormatSelect" ItemsSource="{Binding Options.OutputFormatOptions}" SelectedValue="{Binding CurrentPreset.MuxFormat}" SelectedValueBinding="{Binding Value}" AutomationProperties.Name="封装格式">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Panel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
          <Button Classes="primary" Content="添加封装草稿" Tag="封装" Click="AddTask_Click" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="常用">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,12,10,12">
            <TextBlock Classes="section" Text="ffmpeg pipe"/>
            <TextBlock Classes="muted" Text="通过 FFmpeg 解码和处理视频，并尝试修复音画同步。"/>
            <WrapPanel>
              <Button Content="无音频" Tag="ffmpeg pipe · 无音频" Click="AddTask_Click" Margin="0,0,8,8"/>
              <Button Content="复制音频" Tag="ffmpeg pipe · 复制音频" Click="AddTask_Click" Margin="0,0,8,8"/>
              <Button Content="处理音频与视频" Tag="ffmpeg pipe · 处理音频与视频" Click="AddTask_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Classes="section" Text="内置字幕压制"/>
            <Grid ColumnDefinitions="140,*" Margin="0,3">
              <Label Content="ASS 文件" Target="{Binding #BurnSubtitleField}" VerticalAlignment="Center"/>
              <Panel Grid.Column="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Name="BurnSubtitleField" Text="{Binding Subtitle}" AutomationProperties.Name="ASS 文件"/>
                  <Button Grid.Column="1" Content="浏览…" Tag="subtitle" Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>
              </Panel>
            </Grid>
            <TextBlock Classes="muted" Text="使用编码器的内置 libass 压制字幕。"/>
            <Button Classes="primary" Content="添加字幕压制草稿" Tag="字幕压制" Click="AddTask_Click" HorizontalAlignment="Right"/>
            <Button Classes="primary" Content="添加 HDR 字幕草稿" Tag="字幕压制（HDR）" Click="AddTask_Click" HorizontalAlignment="Right"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0"/>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
