<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NegativeEncoder.Desktop.Views" xmlns:models="using:NegativeEncoder.Desktop.Models"
        x:Class="NegativeEncoder.Desktop.Views.MainWindow" Title="{Binding Title}"
        Width="1320" Height="850" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="avares://NegativeEncoder.Desktop/Assets/app-icon.ico">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="文件">
        <NativeMenu>
          <NativeMenuItem Header="导入视频…" Gesture="Meta+O" Click="ImportFiles_NativeClick" />
          <NativeMenuItem Header="清空待处理列表" Click="ClearFiles_NativeClick" />
          <NativeMenuItem Header="开始任务调度" Click="StartQueue_NativeClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="预设">
        <NativeMenu>
          <NativeMenuItem Header="新建…" Click="NewPreset_NativeClick" />
          <NativeMenuItem Header="保存预设" Gesture="Meta+S" Click="SavePreset_NativeClick" />
          <NativeMenuItem Header="另存为…" Click="CopyPreset_NativeClick" />
          <NativeMenuItem Header="重命名…" Click="RenamePreset_NativeClick" />
          <NativeMenuItem Header="删除…" Click="DeletePreset_NativeClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="导入预设集合" IsEnabled="False" />
          <NativeMenuItem Header="导出预设集合" IsEnabled="False" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="帮助">
        <NativeMenu>
          <NativeMenuItem Header="检查更新" IsEnabled="False" />
          <NativeMenuItem Header="工具库管理" Click="ToolLibrary_NativeClick" />
          <NativeMenuItem Header="启动工具包命令行" IsEnabled="False" />
          <NativeMenuItemSeparator /><NativeMenuItem Header="关于消极压制" Click="About_NativeClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu IsVisible="{OnPlatform macOS=False, Default=True}">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="导入视频…" Click="ImportFiles_Click" />
        <MenuItem Header="清空待处理列表" Click="ClearFiles_Click" />
        <MenuItem Header="开始任务调度" Click="StartQueue_Click" />
        <Separator /><MenuItem Header="退出" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Name="PresetMenu" Header="预设(_P)">
        <MenuItem Header="新建…" Click="NewPreset_Click" />
        <MenuItem Header="保存预设" Click="SavePreset_Click" />
        <MenuItem Header="另存为…" Click="CopyPreset_Click" />
        <MenuItem Header="重命名…" Click="RenamePreset_Click" />
        <MenuItem Header="删除…" Click="DeletePreset_Click" />
        <Separator />
        <MenuItem Header="导入预设集合" IsEnabled="False" />
        <MenuItem Header="导出预设集合" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="检查更新" IsEnabled="False" />
        <MenuItem Header="工具库管理" Click="ToolLibrary_Click" />
        <MenuItem Header="启动工具包命令行" IsEnabled="False" />
        <Separator /><MenuItem Header="关于消极压制" Click="About_Click" />
      </MenuItem>
    </Menu>
    <Grid Grid.Row="1" Margin="12,10,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="440" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="230" MinWidth="180" />
      </Grid.ColumnDefinitions>
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="待处理视频" Classes="heading" /><TextBlock Grid.Column="1" Text="{Binding FileCount}" Classes="muted" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,8">
            <Button Name="ImportButton" Content="＋ 导入视频" Click="ImportFiles_Click" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="移除" Click="RemoveFiles_Click" Margin="6,0,0,0" />
          </Grid>
          <Grid Grid.Row="2" DragDrop.AllowDrop="True" Name="FileDropArea">
            <ListBox Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Multiple,Toggle" SelectionChanged="Files_SelectionChanged">
              <ListBox.ItemTemplate><DataTemplate x:DataType="models:VideoFile">
                <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <CheckBox Grid.Row="3" Content="批量处理全部文件" IsChecked="{Binding ProcessAll}" Margin="0,8,0,0" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="2" Classes="panel" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="48,*,Auto" Margin="0,0,0,8">
            <Label Content="输入" Target="{Binding #InputPath}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Name="InputPath" Text="{Binding InputPath}" IsReadOnly="True" Watermark="从左侧选择视频" AutomationProperties.Name="视频输入路径" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="48,*,Auto" Margin="0,0,0,12">
            <Label Content="输出" Target="{Binding #OutputPath}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="OutputPath" Text="{Binding OutputPath}" Watermark="选择输出位置" AutomationProperties.Name="视频输出路径" />
            <Button Grid.Column="2" Content="浏览…" Click="OutputBrowse_Click" Margin="8,0,0,0" />
          </Grid>
          <views:FunctionTabs Grid.Row="2" Name="EditorTabs" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="任务队列" Classes="heading" /><TextBlock Grid.Column="1" Text="{Binding TaskCount}" Classes="muted" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="2">
            <ListBox Name="TaskList" ItemsSource="{Binding Tasks}" DoubleTapped="Task_DoubleTapped">
              <ListBox.ItemTemplate><DataTemplate x:DataType="models:TaskDraft">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Operation}" />
                  <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" />
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <StackPanel Grid.Row="3" Spacing="6"><Button Content="取消任务" Click="CancelTask_Click" /><Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <Button Content="查看详情" Click="TaskDetails_Click" />
            <Button Grid.Column="1" Content="移除" Click="RemoveTask_Click" />
          </Grid><Button Name="UndoTaskButton" Content="撤销移除" Click="UndoTask_Click" IsVisible="False" /></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" Name="StatusText" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="1" Text="{Binding Platform}" Classes="muted" Margin="16,0,0,0" TextWrapping="NoWrap" MaxLines="1" />
      </Grid>
    </Border>
  </Grid>
</Window>
