<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:NegativeEncoder.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NegativeEncoder.Desktop.Views" xmlns:models="using:NegativeEncoder.Desktop.Models"
        x:Class="NegativeEncoder.Desktop.Views.MainWindow" Title="{Binding Title}"
        Width="1320" Height="850" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="avares://NegativeEncoder.Desktop/Assets/app-icon.ico">
  <Window.Resources>
    <NativeMenu x:Key="NativePresetActions">
      <NativeMenuItem Header="{loc:Tr MainWindow.New}" Click="NewPreset_NativeClick" />
      <NativeMenuItem Header="{loc:Tr MainWindow.SavePreset}" Gesture="Meta+S" Click="SavePreset_NativeClick" />
      <NativeMenuItem Header="{loc:Tr MainWindow.SaveAs}" Click="CopyPreset_NativeClick" />
      <NativeMenuItem Header="{loc:Tr MainWindow.Rename}" Click="RenamePreset_NativeClick" />
      <NativeMenuItem Header="{loc:Tr MainWindow.Delete}" Click="DeletePreset_NativeClick" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="{loc:Tr MainWindow.ImportPresets}" IsEnabled="False" />
      <NativeMenuItem Header="{loc:Tr MainWindow.ExportPresets}" IsEnabled="False" />
    </NativeMenu>
    <NativeMenu x:Key="NativeHelpActions">
      <NativeMenuItem Header="{loc:Tr MainWindow.ToolLibrary}" Click="ToolLibrary_NativeClick" />
      <NativeMenuItem Header="{loc:Tr MainWindow.ToolkitTerminal}" Click="ToolkitTerminal_NativeClick" />
      <NativeMenuItemSeparator /><NativeMenuItem Header="{loc:Tr MainWindow.About}" Click="About_NativeClick" />
    </NativeMenu>
  </Window.Resources>
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{loc:Tr MainWindow.File}">
        <NativeMenu>
          <NativeMenuItem Header="{loc:Tr MainWindow.ImportVideosMenu}" Gesture="Meta+O" Click="ImportFiles_NativeClick" />
          <NativeMenuItem Header="{loc:Tr MainWindow.ClearFiles}" Click="ClearFiles_NativeClick" />
          <NativeMenuItem Header="{loc:Tr MainWindow.StartQueue}" Click="StartQueue_NativeClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{loc:Tr MainWindow.Settings}" Click="Settings_NativeClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{loc:Tr MainWindow.Presets}" Menu="{StaticResource NativePresetActions}" />
      <NativeMenuItem Header="{loc:Tr MainWindow.Help}" Menu="{StaticResource NativeHelpActions}" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu IsVisible="{OnPlatform macOS=False, Default=True}">
      <MenuItem Header="{loc:Tr MainWindow.FileMnemonic}">
        <MenuItem Header="{loc:Tr MainWindow.ImportVideosMenu}" Click="ImportFiles_Click" />
        <MenuItem Header="{loc:Tr MainWindow.ClearFiles}" Click="ClearFiles_Click" />
        <MenuItem Header="{loc:Tr MainWindow.StartQueue}" Click="StartQueue_Click" />
        <Separator /><MenuItem Header="{loc:Tr MainWindow.Settings}" Click="Settings_Click" />
        <Separator /><MenuItem Header="{loc:Tr MainWindow.Exit}" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Name="PresetMenu" Header="{loc:Tr MainWindow.PresetsMnemonic}">
        <MenuItem Header="{loc:Tr MainWindow.New}" Click="NewPreset_Click" />
        <MenuItem Header="{loc:Tr MainWindow.SavePreset}" Click="SavePreset_Click" />
        <MenuItem Header="{loc:Tr MainWindow.SaveAs}" Click="CopyPreset_Click" />
        <MenuItem Header="{loc:Tr MainWindow.Rename}" Click="RenamePreset_Click" />
        <MenuItem Header="{loc:Tr MainWindow.Delete}" Click="DeletePreset_Click" />
        <Separator />
        <MenuItem Header="{loc:Tr MainWindow.ImportPresets}" IsEnabled="False" />
        <MenuItem Header="{loc:Tr MainWindow.ExportPresets}" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="{loc:Tr MainWindow.HelpMnemonic}">
        <MenuItem Name="CheckUpdates" Header="{loc:Tr MainWindow.CheckUpdates}" Click="CheckUpdates_Click" />
        <MenuItem Name="NewRelease" IsVisible="False" Click="Release_Click" />
        <MenuItem Header="{loc:Tr MainWindow.ToolLibrary}" Click="ToolLibrary_Click" />
        <MenuItem Header="{loc:Tr MainWindow.ToolkitTerminal}" Click="ToolkitTerminal_Click" />
        <Separator /><MenuItem Header="{loc:Tr MainWindow.About}" Click="About_Click" />
      </MenuItem>
    </Menu>
    <Grid Grid.Row="1" Margin="12,10,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="440" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="230" MinWidth="180" />
      </Grid.ColumnDefinitions>
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Tr MainWindow.InputVideos}" Classes="heading" /><TextBlock Grid.Column="1" Text="{Binding FileCount}" Classes="muted" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,8">
            <Button Name="ImportButton" Content="{loc:Tr MainWindow.AddVideos}" Click="ImportFiles_Click" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="{loc:Tr MainWindow.Remove}" Click="RemoveFiles_Click" Margin="6,0,0,0" />
          </Grid>
          <Grid Grid.Row="2" Name="FileDropArea">
            <ListBox Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Multiple,Toggle" SelectionChanged="Files_SelectionChanged">
              <ListBox.ItemTemplate><DataTemplate x:DataType="models:VideoFile">
                <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <CheckBox Grid.Row="3" Content="{loc:Tr MainWindow.BatchAllFiles}" IsChecked="{Binding ProcessAll}" Margin="0,8,0,0" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="2" Classes="panel" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <Label Content="{loc:Tr MainWindow.Input}" Target="{Binding #InputPath}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Name="InputPath" Text="{Binding InputPath}" IsReadOnly="True" Watermark="{loc:Tr MainWindow.SelectInput}" AutomationProperties.Name="{loc:Tr MainWindow.VideoInputPath}" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Label Content="{loc:Tr MainWindow.Output}" Target="{Binding #OutputPath}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="OutputPath" Text="{Binding OutputPath}" Watermark="{loc:Tr MainWindow.ChooseOutput}" AutomationProperties.Name="{loc:Tr MainWindow.VideoOutputPath}" />
            <Button Grid.Column="2" Content="{loc:Tr FunctionTabs.Browse}" Click="OutputBrowse_Click" Margin="8,0,0,0" />
          </Grid>
          <views:FunctionTabs Grid.Row="2" Name="EditorTabs" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Tr MainWindow.TaskQueue}" Classes="heading" /><TextBlock Grid.Column="1" Text="{Binding TaskCount}" Classes="muted" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="2">
            <ListBox Name="TaskList" ItemsSource="{Binding Tasks}" DoubleTapped="Task_DoubleTapped">
              <ListBox.ItemTemplate><DataTemplate x:DataType="models:TaskDraft">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding OperationLabel}" />
                  <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" />
                  <ProgressBar Classes="encoding" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                               AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding ProgressSummary}" />
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <StackPanel Grid.Row="3" Spacing="6"><Button Content="{loc:Tr MainWindow.CancelTask}" Click="CancelTask_Click" /><Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <Button Content="{loc:Tr MainWindow.TaskDetails}" Click="TaskDetails_Click" />
            <Button Grid.Column="1" Content="{loc:Tr MainWindow.Remove}" Click="RemoveTask_Click" />
          </Grid><Button Name="UndoTaskButton" Content="{loc:Tr MainWindow.UndoRemoval}" Click="UndoTask_Click" IsVisible="False" /></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
      <Grid ColumnDefinitions="*,Auto">
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Status}" Name="StatusText" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Column="1" Text="{Binding CurrentTask.ProgressSummary}" IsVisible="{Binding HasRunningTasks}"
                     Name="ProgressSummary" ToolTip.Tip="{Binding CurrentTask.Name}" Margin="12,0,0,0" TextWrapping="NoWrap" />
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding Platform}" IsVisible="{Binding !HasRunningTasks}" Classes="muted" Margin="16,0,0,0" TextWrapping="NoWrap" MaxLines="1" />
        <ProgressBar Grid.Column="1" Classes="encoding" Name="QueueProgress" Width="150" Margin="16,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding HasRunningTasks}" IsIndeterminate="{Binding GlobalIndeterminate}" Value="{Binding GlobalProgress}"
                     AutomationProperties.Name="{loc:Tr MainWindow.QueueProgress}" ToolTip.Tip="{loc:Tr MainWindow.QueueProgress}" />
      </Grid>
    </Border>
  </Grid>
</Window>
