<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <Version>6.0.0-alpha.1</Version>
    <Description>NegativeEncoder cross-platform desktop application</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <AvaloniaResource Include="Assets/app-icon.png" />
    <AvaloniaResource Include="Assets/app-icon.ico" />
  </ItemGroup>
</Project>
