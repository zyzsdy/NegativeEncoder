    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../NegativeEncoder/ne.ico</ApplicationIcon>
    <Version>6.0.0-ui-preview</Version>
    <Description>NegativeEncoder cross-platform UI preview</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
