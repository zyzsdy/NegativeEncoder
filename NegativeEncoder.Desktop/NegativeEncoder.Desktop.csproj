    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <AvaloniaResource Include="../NegativeEncoder/Resources/icon.png" Link="Assets/icon.png" />
    <AvaloniaResource Include="../NegativeEncoder/ne.ico" Link="Assets/ne.ico" />
  </ItemGroup>
</Project>
