Unicode True

; Script generated by the HM NIS Edit Script Wizard.
!include "x64.nsh"

; HM NIS Edit Wizard helper defines
!define PRODUCT_NAME "消极压制"
!ifndef PRODUCT_VERSION
  !define PRODUCT_VERSION "5.2.0.0"
!endif
!ifndef PACKAGE_DIR
  !define PACKAGE_DIR ".."
!endif
!ifndef OUTPUT_FILE
  !define OUTPUT_FILE "NegativeEncoderSetup.exe"
!endif
!define PRODUCT_PUBLISHER "Ted Zyzsdy"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\NegativeEncoder.exe"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKCU"
!define PRODUCT_STARTMENU_REGVAL "NSIS:StartMenuDir"

SetCompressor /SOLID lzma

; MUI 1.67 compatible ------
!include "MUI2.nsh"
!include "FileFunc.nsh"

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "install.ico"
!define MUI_UNICON "install.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "up.bmp"
!define MUI_WELCOMEPAGE_TITLE "NegativeEncoder 消极压制 v${PRODUCT_VERSION} 安装向导"

; Welcome page
!insertmacro MUI_PAGE_WELCOME
; License page
!insertmacro MUI_PAGE_LICENSE "licence.txt"
!insertmacro MUI_PAGE_COMPONENTS
; Directory page
!insertmacro MUI_PAGE_DIRECTORY
; Start menu page
var ICONS_GROUP
!define MUI_STARTMENUPAGE_NODISABLE
!define MUI_STARTMENUPAGE_DEFAULTFOLDER "消极压制"
!define MUI_STARTMENUPAGE_REGISTRY_ROOT "${PRODUCT_UNINST_ROOT_KEY}"
!define MUI_STARTMENUPAGE_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "${PRODUCT_STARTMENU_REGVAL}"
!insertmacro MUI_PAGE_STARTMENU Application $ICONS_GROUP
; Instfiles page
!insertmacro MUI_PAGE_INSTFILES
; Finish page
!define MUI_FINISHPAGE_RUN "$INSTDIR\NEbin\NegativeEncoder.exe"
!define MUI_FINISHPAGE_RUN_PARAMETERS "--runFunc InstallCmdTools"
!define MUI_FINISHPAGE_RUN_TEXT "将“启动消极压制工具包命令行”添加到右键菜单"
!insertmacro MUI_PAGE_FINISH

; Uninstaller pages
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; Language files
!insertmacro MUI_LANGUAGE "SimpChinese"

; Reserve files
;!insertmacro MUI_RESERVEFILE_INSTALLOPTIONS

; MUI end ------

RequestExecutionLevel user

Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "${OUTPUT_FILE}"
InstallDir "$LOCALAPPDATA\NegativeEncoder"
InstallDirRegKey HKCU "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show
BrandingText "MeowSound Idols"

VIProductVersion "${PRODUCT_VERSION}"
VIAddVersionKey /LANG=2052 "ProductName" "${PRODUCT_NAME}"
VIAddVersionKey /LANG=2052 "CompanyName" "${PRODUCT_PUBLISHER}"
VIAddVersionKey /LANG=2052 "LegalCopyright" "Copyright © 2018-2026 ${PRODUCT_PUBLISHER}"
VIAddVersionKey /LANG=2052 "FileDescription" "${PRODUCT_NAME} Installer"
VIAddVersionKey /LANG=2052 "FileVersion" "${PRODUCT_VERSION}"

Section "主程序" SEC01
  SectionIn RO
  SetRegView 64
  SetOutPath "$INSTDIR\NEbin"
  SetOverwrite try
  File /r "${PACKAGE_DIR}\NEbin\*.*"

; Shortcuts
  !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
  CreateDirectory "$SMPROGRAMS\$ICONS_GROUP"
  CreateShortCut "$SMPROGRAMS\$ICONS_GROUP\消极压制.lnk" "$INSTDIR\NEbin\NegativeEncoder.exe" "" "$INSTDIR\NEbin\ne.ico"
  CreateShortCut "$DESKTOP\消极压制.lnk" "$INSTDIR\NEbin\NegativeEncoder.exe" "" "$INSTDIR\NEbin\ne.ico"
  !insertmacro MUI_STARTMENU_WRITE_END
SectionEnd

Section "工具包" SEC02
  SectionIn RO
  SetRegView 64
  SetOutPath "$INSTDIR\Libs"
  File /r "${PACKAGE_DIR}\Libs\*.*"
  SetOutPath "$INSTDIR"
  File "${PACKAGE_DIR}\dependencies.lock.json"
  File "${PACKAGE_DIR}\THIRD-PARTY-NOTICES.md"
  SetOutPath "$INSTDIR\ThirdParty"
  File /r "${PACKAGE_DIR}\ThirdParty\*.*"
  SetOutPath "$INSTDIR\Setup"
  File "apple-runtime.lock.json"

; Shortcuts
  !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
  !insertmacro MUI_STARTMENU_WRITE_END
SectionEnd

Section /o "Apple AAC 运行库（可选，联网安装）" SECAPPLE
  DetailPrint "检测并准备 qaac 所需 Apple 运行库..."
  nsExec::ExecToStack '"$INSTDIR\NEbin\NegativeEncoder.exe" --runFunc InstallAppleRuntime'
  Pop $0
  Pop $1
  DetailPrint "$1"
  StrCmp $0 "3010" apple_reboot
  StrCmp $0 "0" apple_done
  MessageBox MB_ICONEXCLAMATION|MB_OK "Apple 运行库安装未完成。主程序将继续安装，qaac 功能暂不可用。可重新运行本安装程序，选择 Apple AAC 运行库组件。$\r$\n$1" /SD IDOK
  Goto apple_done
apple_reboot:
  SetRebootFlag true
apple_done:
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC01} "NegativeEncoder 主程序。"
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC02} "固定版本的编码器、FFmpeg、VapourSynth 及插件。"
  !insertmacro MUI_DESCRIPTION_TEXT ${SECAPPLE} "已有可用 qaac 运行库时跳过安装。否则从 Apple 官方下载约 264 MB 的历史安装包，安装 x64 Application Support 6.2.1（2017 年版本）。将显示 Apple 协议和安装向导，可能需要管理员权限。"
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section -AdditionalIcons
  SetRegView 64
  SetOutPath $INSTDIR
  !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
  CreateShortCut "$SMPROGRAMS\$ICONS_GROUP\Uninstall.lnk" "$INSTDIR\uninst.exe" "" "$INSTDIR\NEbin\ne.ico"
  !insertmacro MUI_STARTMENU_WRITE_END
SectionEnd

Section -Post
  SetRegView 64
  WriteUninstaller "$INSTDIR\uninst.exe"
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  WriteRegStr HKCU "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString" '"$INSTDIR\uninst.exe"'
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "$INSTDIR\NEbin\ne.ico"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "NoModify" 1
  WriteRegDWORD ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "NoRepair" 1
  WriteRegDWORD ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "EstimatedSize" $0
SectionEnd

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP "此安装包需要 64 位 Windows。"
    Abort
  ${EndIf}
  SetRegView 64
FunctionEnd


Function un.onUninstSuccess
  HideWindow
  MessageBox MB_ICONINFORMATION|MB_OK "$(^Name) 已成功地从你的计算机移除。"
FunctionEnd

Function un.onInit
  SetRegView 64
  MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON2 "你确实要完全移除 $(^Name) ，其及所有的组件？" IDYES +2
  Abort
FunctionEnd

Section Uninstall
  !insertmacro MUI_STARTMENU_GETFOLDER "Application" $ICONS_GROUP
  Delete "$INSTDIR\uninst.exe"
  RMDir /r "$INSTDIR"

  Delete "$SMPROGRAMS\$ICONS_GROUP\Uninstall.lnk"
  Delete "$DESKTOP\消极压制.lnk"
  Delete "$SMPROGRAMS\$ICONS_GROUP\消极压制.lnk"

  RMDir "$SMPROGRAMS\$ICONS_GROUP"

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKCU "${PRODUCT_DIR_REGKEY}"
  SetAutoClose true
SectionEnd
